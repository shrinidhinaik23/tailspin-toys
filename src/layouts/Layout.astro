---
import Header from "../components/Header.astro"
import "../styles/global.css"

interface Props {
  title?: string;
}

const { title = "Tailspin Toys" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <script is:inline>
            if (localStorage.getItem("tailspin-high-contrast") === "true") {
                document.documentElement.classList.add("high-contrast");
            }
        </script>
        <!-- Preconnect to improve font loading -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </head>
    <body class="min-h-screen bg-slate-900 text-white transition-colors duration-300 m-0 w-full h-full font-sans">
        <Header />
        <main class="container mx-auto py-6 h-full max-w-7xl">
            <div class="px-4 sm:px-6 lg:px-8">
                <slot />
            </div>
        </main>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }
    
    html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
    }

    html.high-contrast {
        color-scheme: dark;
    }

    html.high-contrast body {
        background-color: #000;
        color: #fff;
    }

    html.high-contrast header {
        background-color: #000;
        border-bottom: 2px solid #fff;
    }

    html.high-contrast a,
    html.high-contrast button {
        text-decoration-thickness: 2px;
    }

    html.high-contrast a:focus-visible,
    html.high-contrast button:focus-visible {
        outline: 3px solid #ffff00;
        outline-offset: 3px;
    }

    html.high-contrast [class*="bg-slate-800"],
    html.high-contrast [class*="bg-slate-900"] {
        background-color: #111;
    }

    html.high-contrast [class*="text-slate-400"],
    html.high-contrast [class*="text-slate-300"],
    html.high-contrast [class*="text-slate-200"],
    html.high-contrast [class*="text-slate-100"],
    html.high-contrast [class*="text-white"] {
        color: #fff;
    }

    html.high-contrast [class*="text-blue-400"],
    html.high-contrast [class*="text-purple-400"] {
        color: #ffff00;
    }

    html.high-contrast [class*="border-slate-"] {
        border-color: #fff;
    }
    
    body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>
